# BASE COLORS (raw)
accent.raw                  {accent}

# HEX
accent.hex                  {accent.hex}
accent.hex.stripped         {accent.hex_stripped}

accent.hexa                 {accent.hexa}
accent.hexa.stripped        {accent.hexa_stripped}

# RGB (0–255)
accent.rgb                  {accent.rgb}
accent.r                    {accent.r}
accent.g                    {accent.g}
accent.b                    {accent.b}

# RGBA (A = 0–1 normalized)
accent.rgba                 {accent.rgba}
accent.a                    {accent.a}

# HSL (normalized 0–1 for s,l, integers for h)
accent.hsl                  {accent.hsl}
accent.h                    {accent.h}
accent.s                    {accent.s}
accent.l                    {accent.l}

# HSLA
accent.hsla                 {accent.hsla}
accent.hsla_a               {accent.hsla_a}

# Combined custom formats
accent.r-g-b                {accent.r}-{accent.g}-{accent.b}
accent.r-g-b-a              {accent.r}-{accent.g}-{accent.b}-{accent.a}

accent.h-s-l                {accent.h}-{accent.s}-{accent.l}
accent.h-s-l-a              {accent.h}-{accent.s}-{accent.l}-{accent.hsla_a}
# ── Key groups ────────────────────────────────────────────────────────────
# Surfaces, background upward:
#   background < surface < surface_variant < surface_container < surface_high
#   border / border_focused sit above surface_high.
#
# Text on a fill: on_background, on_surface, on_surface_variant,
#   on_accent, on_accent_secondary, on_error, on_warning, on_success, on_info
#
# Terminals want ANSI, editors want base16 -- they are NOT the same ordering:
#   term0..term15   ANSI: black red green yellow blue magenta cyan white,
#                   then the eight bright variants.
#   base00..base0F  base16: 00-07 is a background-to-foreground ramp,
#                   08-0F are red orange yellow green cyan blue magenta brown.
# Using base01 where you meant "red" gives you a background step instead.
